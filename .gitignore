# Réglages personnels de l'éditeur et de Claude Code
.vscode/
.claude/settings.local.json

# Secrets : certificat de signature du code (outils/signer.py), clés, variables d'environnement
*.pfx
*.p12
*.pem
*.key
.env
.env.*

# Fichiers produits par la compilation de l'installateur
installer/uv.exe
dist/
montage_studio/VERSION
# Environnement Python (recréé par les lanceurs)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Données personnelles et fichiers générés : ne jamais publier
medias/
sorties/
projets/
cache/

# Voix off : clé API ElevenLabs et voix Piper téléchargées (ne jamais publier)
voix_config.json
licence_pro.txt
# Clé privée du vendeur de MSV Pro : jamais dans le dépôt (elle est rangée dans %APPDATA%\MSV-vendeur)
cle_privee.txt
modeles_voix/

*.mp3
*.wav
*.ogg
*.mp4
# Exception : vidéos de la page d'accueil du site (GitHub Pages), à publier
!docs/video/*.mp4
# Vidéo de présentation : fichiers générés
promo/build/
promo/output/

# Édition pro : FFmpeg LGPL préparé par outils/ffmpeg_lgpl.py (gros binaire, recréé à la demande)
installer/pro/ffmpeg/
montage_studio/EDITION
