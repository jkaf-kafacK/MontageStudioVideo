{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSV Editeur",
  "mainBinaryName": "MSV-Editeur",
  "version": "1.0.0",
  "identifier": "com.montagestudiovideo.editeur",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Montage Studio Video — Éditeur",
        "url": "index.html",
        "width": 1600,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
